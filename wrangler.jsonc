{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "vilis",
	"main": "./.output/server/index.mjs",
	"assets": {
		"directory": "./.output/public",
	},
	"compatibility_date": "2026-10-17",
	"compatibility_flags": ["nodejs_compat"],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "alza-dny",
			"database_id": "72a23338-8beb-4e33-98da-dea6c467fe5a",
			"migrations_dir": "cloudflare/migrations",
		},
	],
	"previews": {
		"d1_databases": [
			{
				"binding": "DB",
				"database_name": "alza-dny-preview",
				"database_id": "b8f38032-a558-494c-8cce-4b78419fd041",
			},
		],
	},
	"observability": {
		"enabled": true,
	},
}
